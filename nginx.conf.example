##
## SHULKER — Nginx configuration example
## Place in /etc/nginx/sites-available/shulker and symlink to sites-enabled.
##

server {
    listen 80;
    listen [::]:80;
    server_name yourdomain.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name yourdomain.com;

    root /var/www/shulker;
    index index.php;

    # SSL (replace with your cert paths or use Certbot)
    ssl_certificate     /etc/letsencrypt/live/yourdomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yourdomain.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Security headers
    add_header X-Content-Type-Options   "nosniff"          always;
    add_header X-Robots-Tag             "noindex,nofollow" always;
    add_header X-Frame-Options          "DENY"             always;
    add_header Referrer-Policy          "no-referrer"      always;

    # Block directory listing
    autoindex off;

    # Block access to sensitive directories
    location ~ ^/(storage|includes|config\.php) {
        deny all;
        return 403;
    }

    # Serve static images directly (Cloudflare caches these)
    location ~* ^/images/.*\.(avif|webm)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;

        # Block PHP execution in images dir
        location ~* \.php$ { deny all; }
    }

    # Deny .json access under images
    location ~* ^/images/.*\.json$ {
        deny all;
    }

    # Route everything else through index.php
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php8.2-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;

        # Increase upload limits
        fastcgi_read_timeout 60;
        client_max_body_size 6M;
    }

    # PHP upload size
    client_max_body_size 6M;
}
